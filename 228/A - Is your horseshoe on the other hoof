#include <bits/stdc++.h>
#define int long long
using namespace std;
 
signed main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
 
    int a[4];
    for (int i = 0; i < 4; ++i)
    {
        cin >> a[i];
    }
    sort(a, a + 4);
    int cnt = 0;
    for (int i = 0; i < 4 - 1; ++i)
    {
        if (a[i] == a[i + 1])
        {
            cnt++;
        }
    }
    cout << cnt << '
';
}